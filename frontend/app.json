{
  "expo": {
    "name": "Paws Peace",
    "slug": "paws-peace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.pawspeace.app"
    },
    "plugins": [
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CatWidget",
              "label": "Paws Peace",
              "description": "Statut des chats et bouton sortie/rentrée",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "31833205-bfd0-42a9-85e5-1ac94fb737ac"
      }
    },
    "owner": "drouart"
  }
}
