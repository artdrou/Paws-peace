{
  "expo": {
    "name": "Paws Peace",
    "slug": "paws-peace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.pawspeace.app",
      "runtimeVersion": {
        "policy": "fingerprint"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5E7A8F",
          "sounds": [
            "./assets/sounds/miaou_sortie.wav",
            "./assets/sounds/miaou_rentree.wav",
            "./assets/sounds/bagarre.wav"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CatWidget",
              "label": "Paws Peace",
              "description": "Statut des chats et bouton sortie/rentrée",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "31833205-bfd0-42a9-85e5-1ac94fb737ac"
      }
    },
    "owner": "drouart",
    "updates": {
      "url": "https://u.expo.dev/31833205-bfd0-42a9-85e5-1ac94fb737ac"
    }
  }
}
